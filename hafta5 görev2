# BÖLÜM 4: TEST VE GÖRSELLEŞTİRME
# =====================================================================

print("Lütfen işlemek istediğiniz renkli görseli yükleyin:")
uploaded = files.upload()

if uploaded:
    file_name = list(uploaded.keys())[0]
    img_bgr = cv2.imread(file_name)
    img_rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)
    
    # İşlem süresini makul tutmak için çok büyükse yeniden boyutlandıralım (maks genişlik 500px)
    max_dim = 500
    h, w = img_rgb.shape[:2]
    if max(h, w) > max_dim:
        scale = max_dim / max(h, w)
        img_rgb = cv2.resize(img_rgb, (int(w * scale), int(h * scale)))

    # 1. Histogram Çizimi
    print("\n1. RGB Kanalları Histogramı çiziliyor...")
    plot_color_histograms(img_rgb)

    # 2. Griye Çevirme (Sıfırdan formülle)
    print("2. Görüntü sıfırdan siyah-beyaza çevriliyor...")
    gray_img = rgb_to_grayscale(img_rgb)

    # 3. Canny Adım 1: Gauss Bulanıklaştırma (5x5)
    print("3. Gauss filtresi uygulanıyor (Gürültü bastırma)...")
    blurred_img = gaussian_blur_5x5(gray_img, sigma=1.4)

    # 4. Canny Adım 2: Sobel Gradyanları
    print("4. Sobel filtresi ile gradyan büyüklüğü ve yönü hesaplanıyor...")
    magnitude, angle = sobel_gradients(blurred_img)

    # 5. Canny Adım 3: Non-Maximum Suppression (NMS)
    print("5. Non-Maximum Suppression (NMS) ile kenarlar inceltiliyor...")
    nms_img = non_maximum_suppression(magnitude, angle)

    # 6. Canny Adım 4: Hysteresis Thresholding
    print("6. Hysteresis Thresholding ile kenar takibi tamamlanıyor...")
    canny_result = hysteresis_thresholding(nms_img, low_ratio=0.1, high_ratio=0.25)

    # --- TÜM ADIMLARIN KARŞILAŞTIRMALI ÇIKTISI ---
    fig, axes = plt.subplots(2, 3, figsize=(18, 12))

    axes[0, 0].imshow(img_rgb)
    axes[0, 0].set_title("1. Orijinal Renkli Görüntü")
    axes[0, 0].axis("off")

    axes[0, 1].imshow(gray_img, cmap='gray')
    axes[0, 1].set_title("2. Siyah-Beyaz (Grayscale)")
    axes[0, 1].axis("off")

    axes[0, 2].imshow(blurred_img, cmap='gray')
    axes[0, 2].set_title("3. 5x5 Gauss Filtresi Sonucu")
    axes[0, 2].axis("off")

    axes[1, 0].imshow(magnitude, cmap='gray')
    axes[1, 0].set_title("4. Sobel Gradyan Büyüklüğü")
    axes[1, 0].axis("off")

    axes[1, 1].imshow(nms_img, cmap='gray')
    axes[1, 1].set_title("5. Non-Maximum Suppression (NMS)")
    axes[1, 1].axis("off")

    axes[1, 2].imshow(canny_result, cmap='gray')
    axes[1, 2].set_title("6. Hysteresis (Final Canny Kenarları)")
    axes[1, 2].axis("off")

    plt.tight_layout()
    plt.show()
