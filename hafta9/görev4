#include <opencv2/opencv.hpp>
#include <iostream>

using namespace cv;
using namespace std;

// OpenCV'de direkt HSI fonksiyonu olmadigi icin manuel donusum fonksiyonu
void convertBGR2HSI(const Mat& src, Mat& dst) {
    dst = Mat(src.rows, src.cols, CV_32FC3);
    for (int i = 0; i < src.rows; i++) {
        for (int j = 0; j < src.cols; j++) {
            float b = src.at<Vec3b>(i, j)[0] / 255.0;
            float g = src.at<Vec3b>(i, j)[1] / 255.0;
            float r = src.at<Vec3b>(i, j)[2] / 255.0;

            float num = 0.5 * ((r - g) + (r - b));
            float den = sqrt((r - g) * (r - g) + (r - b) * (g - b));
            float theta = acos(num / (den + 1e-5));

            float H = (b <= g) ? theta : (2 * CV_PI - theta);
            float min_val = min(min(b, g), r);
            float sum = r + g + b;
            float S = (sum == 0) ? 0 : (1 - 3.0 * min_val / sum);
            float I = sum / 3.0;

            dst.at<Vec3f>(i, j)[0] = H * 180 / CV_PI; 
            dst.at<Vec3f>(i, j)[1] = S * 255;
            dst.at<Vec3f>(i, j)[2] = I * 255;
        }
    }
    dst.convertTo(dst, CV_8UC3);
}

int main() {
    // Disk uzerinden resmi oku (Colab icine ornek_resim.bmp yuklediginden emin ol)
    Mat img = imread("ornek_resim.bmp", IMREAD_COLOR);
    if(img.empty()) { 
        cout << "ornek_resim.bmp bulunamadi!" << endl; 
        return -1; 
    }

    Mat hsv, yuv, lab, hsi;
    
    cvtColor(img, hsv, COLOR_BGR2HSV);
    cvtColor(img, yuv, COLOR_BGR2YUV);
    cvtColor(img, lab, COLOR_BGR2Lab);
    
    // Kendi yazdigimiz HSI fonksiyonunu cagiriyoruz
    convertBGR2HSI(img, hsi);

    imwrite("sonuc_hsv.bmp", hsv);
    imwrite("sonuc_yuv.bmp", yuv);
    imwrite("sonuc_lab.bmp", lab);
    imwrite("sonuc_hsi.bmp", hsi);
    
    cout << "Tum renk uzaylarina donusum yapildi ve .bmp olarak kaydedildi." << endl;
    return 0;
}
