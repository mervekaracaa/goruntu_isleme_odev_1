  import cv2
import numpy as np
from matplotlib import pyplot as plt

disp_raw = cv2.imread("/content/custom_disp_raw.png", cv2.IMREAD_GRAYSCALE)
assert disp_raw is not None, "custom_disp_raw.png bulunamadi; onceki bash hucresini calistirin."

print("Min kayma:", disp_raw.min(), "Max kayma:", disp_raw.max(), "Ortalama:", round(float(disp_raw.mean()), 2))

# Ust %2'lik gurultu ucunu kirparak kirmizi skalayi yakin nesnelere odaklayalim
upper = float(np.percentile(disp_raw, 98))
if upper <= 0:
    upper = 1.0

disp_clipped = np.clip(disp_raw.astype(np.float32), 0.0, upper)
disp_norm = ((disp_clipped / upper) * 255.0).astype(np.uint8)
disp_color = cv2.applyColorMap(disp_norm, cv2.COLORMAP_JET)

plt.figure(figsize=(9, 5))
plt.imshow(cv2.cvtColor(disp_color, cv2.COLOR_BGR2RGB))
plt.title("Kirpilmis Olcekli Blok Eslesme Haritasi")
plt.axis("off")
plt.show()
