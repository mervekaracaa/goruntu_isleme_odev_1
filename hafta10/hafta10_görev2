#include <iostream>
#include <limits>
#include <cmath>
#include <opencv2/opencv.hpp>

cv::Mat computeCustomDisparity(
    const cv::Mat& left,
    const cv::Mat& right,
    int blockSize = 7,
    int maxDisparity = 64
) {
    CV_Assert(!left.empty() && !right.empty());
    CV_Assert(left.type() == CV_8UC1 && right.type() == CV_8UC1);
    CV_Assert(left.size() == right.size());
    CV_Assert(blockSize % 2 == 1 && blockSize >= 3);

    int rows = left.rows;
    int cols = left.cols;
    int half = blockSize / 2;

    cv::Mat disparity = cv::Mat::zeros(rows, cols, CV_8U);

    for (int y = half; y < rows - half; ++y) {
        for (int x = half + maxDisparity; x < cols - half; ++x) {
            int bestDisp = 0;
            long long minCost = std::numeric_limits<long long>::max();

            for (int d = 0; d < maxDisparity; ++d) {
                long long sad = 0;

                for (int wy = -half; wy <= half; ++wy) {
                    const uchar* rowL = left.ptr<uchar>(y + wy);
                    const uchar* rowR = right.ptr<uchar>(y + wy);

                    for (int wx = -half; wx <= half; ++wx) {
                        int xl = x + wx;
                        int xr = (x - d) + wx;
                        sad += std::abs(static_cast<int>(rowL[xl]) - static_cast<int>(rowR[xr]));
                    }
                }

                if (sad < minCost) {
                    minCost = sad;
                    bestDisp = d;
                }
            }

            disparity.at<uchar>(y, x) = static_cast<uchar>(bestDisp);
        }
    }

    return disparity;
}

int main() {
    cv::Mat left = cv::imread("/content/scene1.row3.col1.ppm", cv::IMREAD_GRAYSCALE);
    cv::Mat right = cv::imread("/content/scene1.row3.col3.ppm", cv::IMREAD_GRAYSCALE);

    if (left.empty() || right.empty()) {
        std::cerr << "HATA: Goruntuler okunamadi!" << std::endl;
        return 1;
    }

    cv::Mat dispRaw = computeCustomDisparity(left, right, 7, 64);
    cv::imwrite("/content/custom_disp_raw.png", dispRaw);
    std::cout << "TAMAM: /content/custom_disp_raw.png olusturuldu." << std::endl;
    return 0;
}
EOF

