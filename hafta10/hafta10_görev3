#include <iostream>
#include <vector>
#include <string>
#include <cmath>
#include <limits>
#include <chrono>
#include <opencv2/opencv.hpp>

// Ortak fonksiyon pointer tipi:
// (left, right, xL, yL, xR, yR, half) -> double skor dondurur
using BlockCostFunc = double (*)(
    const cv::Mat&, const cv::Mat&, int, int, int, int, int
);

// 1. SAD: Mutlak farklar toplami (kucuk deger daha iyi)
double computeSAD(
    const cv::Mat& left, const cv::Mat& right,
    int xL, int yL, int xR, int yR, int half
) {
    double sum = 0.0;
    for (int wy = -half; wy <= half; ++wy) {
        const uchar* rL = left.ptr<uchar>(yL + wy);
        const uchar* rR = right.ptr<uchar>(yR + wy);
        for (int wx = -half; wx <= half; ++wx) {
            sum += std::abs(static_cast<int>(rL[xL + wx]) - static_cast<int>(rR[xR + wx]));
        }
    }
    return sum;
}

// 2. SSD: Karesel farklar toplami (kucuk deger daha iyi)
double computeSSD(
    const cv::Mat& left, const cv::Mat& right,
    int xL, int yL, int xR, int yR, int half
) {
    double sum = 0.0;
    for (int wy = -half; wy <= half; ++wy) {
        const uchar* rL = left.ptr<uchar>(yL + wy);
        const uchar* rR = right.ptr<uchar>(yR + wy);
        for (int wx = -half; wx <= half; ++wx) {
            double diff = static_cast<double>(rL[xL + wx]) - static_cast<double>(rR[xR + wx]);
            sum += diff * diff;
        }
    }
    return sum;
}

// 3. ZNCC: Sifir-merkezli normalize capraz korelasyon (buyuk deger [-1, 1] daha iyi)
double computeZNCC(
    const cv::Mat& left, const cv::Mat& right,
    int xL, int yL, int xR, int yR, int half
) {
    const int n = (2 * half + 1) * (2 * half + 1);
    double meanL = 0.0, meanR = 0.0;

    for (int wy = -half; wy <= half; ++wy) {
        const uchar* rL = left.ptr<uchar>(yL + wy);
        const uchar* rR = right.ptr<uchar>(yR + wy);
        for (int wx = -half; wx <= half; ++wx) {
            meanL += rL[xL + wx];
            meanR += rR[xR + wx];
        }
    }
    meanL /= n;
    meanR /= n;

    double num = 0.0, varL = 0.0, varR = 0.0;
    for (int wy = -half; wy <= half; ++wy) {
        const uchar* rL = left.ptr<uchar>(yL + wy);
        const uchar* rR = right.ptr<uchar>(yR + wy);
        for (int wx = -half; wx <= half; ++wx) {
            double dL = static_cast<double>(rL[xL + wx]) - meanL;
            double dR = static_cast<double>(rR[xR + wx]) - meanR;
            num += dL * dR;
            varL += dL * dL;
            varR += dR * dR;
        }
    }

    double denom = std::sqrt(varL * varR);
    if (denom < 1e-6) {
        return -1.0; // Duz/varyansiz blokta guvenli alt sinir
    }
    return num / denom;
}

struct MetricConfig {
    std::string name;
    BlockCostFunc fn;
    bool minimize; // true: dusuk skor iyi (SAD, SSD), false: yuksek skor iyi (ZNCC)
};

cv::Mat runDisparityWithMetric(
    const cv::Mat& left,
    const cv::Mat& right,
    const MetricConfig& cfg,
    int blockSize,
    int maxDisparity
) {
    CV_Assert(!left.empty() && !right.empty());
    CV_Assert(left.type() == CV_8UC1 && right.type() == CV_8UC1);
    CV_Assert(left.size() == right.size());
    CV_Assert(blockSize % 2 == 1 && blockSize >= 3);

    int rows = left.rows;
    int cols = left.cols;
    int half = blockSize / 2;

    cv::Mat disp = cv::Mat::zeros(rows, cols, CV_8U);

    for (int y = half; y < rows - half; ++y) {
        for (int x = half + maxDisparity; x < cols - half; ++x) {
            int bestD = 0;
            double bestScore = cfg.minimize
                ? std::numeric_limits<double>::infinity()
                : -std::numeric_limits<double>::infinity();

            for (int d = 0; d < maxDisparity; ++d) {
                double score = cfg.fn(left, right, x, y, x - d, y, half);
                bool better = cfg.minimize ? (score < bestScore) : (score > bestScore);
                if (better) {
                    bestScore = score;
                    bestD = d;
                }
            }

            disp.at<uchar>(y, x) = static_cast<uchar>(bestD);
        }
    }

    return disp;
}

int main() {
    cv::Mat left = cv::imread("/content/scene1.row3.col1.ppm", cv::IMREAD_GRAYSCALE);
    cv::Mat right = cv::imread("/content/scene1.row3.col3.ppm", cv::IMREAD_GRAYSCALE);

    if (left.empty() || right.empty()) {
        std::cerr << "HATA: Goruntuler okunamadi!" << std::endl;
        return 1;
    }

    const int blockSize = 7;
    const int maxDisparity = 64;

    std::vector<MetricConfig> metrics = {
        {"SAD",  &computeSAD,  true},
        {"SSD",  &computeSSD,  true},
        {"ZNCC", &computeZNCC, false}
    };

    for (const auto& m : metrics) {
        auto t0 = std::chrono::high_resolution_clock::now();
        cv::Mat dispRaw = runDisparityWithMetric(left, right, m, blockSize, maxDisparity);
        auto t1 = std::chrono::high_resolution_clock::now();

        double ms = std::chrono::duration<double, std::milli>(t1 - t0).count();

        cv::Mat dispNorm, dispColor;
        cv::normalize(dispRaw, dispNorm, 0, 255, cv::NORM_MINMAX, CV_8U);
        cv::applyColorMap(dispNorm, dispColor, cv::COLORMAP_JET);

        std::string outPath = "/content/disp_" + m.name + ".png";
        cv::imwrite(outPath, dispColor);

        std::cout << m.name << " tamamlandi | Sure: " << ms << " ms | Kaydedildi: " << outPath << std::endl;
    }

    return 0;
}




