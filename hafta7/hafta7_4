import numpy as np
import matplotlib.pyplot as plt

def get_harmonic_vector(vector, sampling_rate):
    """
    Vektör üzerinde DFT (FFT algoritması ile) uygular ve
    pozitif frekanslar için harmonik (genlik) vektörünü döndürür.
    """
    N = len(vector)

    # FFT hesaplaması (Karmaşık sayılar döner)
    fft_result = np.fft.fft(vector)

    # Frekans eksenini oluştur
    freqs = np.fft.fftfreq(N, 1/sampling_rate)

    # Genlikleri hesapla ve normalize et (N'e böl, tek taraflı için 2 ile çarp)
    magnitudes = np.abs(fft_result) / N
    magnitudes = magnitudes * 2

    # Sadece pozitif frekansları al (Nyquist teoremine göre yarısı)
    half_n = N // 2

    return freqs[:half_n], magnitudes[:half_n]

