import numpy as np
import matplotlib.pyplot as plt

def compute_dft(vector, fs):
    """Sinyalin DFT'sini hesaplar ve pozitif frekans/genlik vektörlerini döner."""
    N = len(vector)
    fft_result = np.fft.fft(vector)
    freqs = np.fft.fftfreq(N, 1/fs)
    magnitudes = (np.abs(fft_result) / N) * 2
    return freqs[:N//2], magnitudes[:N//2]

# 1. Parametreler ve Zaman Ekseni
N = 1024
fs = N  # 1 saniyelik periyot olduğu için örnekleme frekansı N'dir
t = np.linspace(0, 1, N, endpoint=False)
gurultu_orani = 0.3 # %30 gürültü

# 2. Sinyal 1 (Frekans: 50 Hz, Genlik: 12) ve Gürültü Eklenmesi
sinyal1 = 12 * np.sin(2 * np.pi * 50 * t)
gurultu1 = np.random.normal(0, 12 * gurultu_orani, N)
sinyal1_gurultulu = sinyal1 + gurultu1

# 3. Sinyal 2 (Frekans: 30 Hz, Genlik: 5) ve Gürültü Eklenmesi
sinyal2 = 5 * np.sin(2 * np.pi * 30 * t)
gurultu2 = np.random.normal(0, 5 * gurultu_orani, N)
sinyal2_gurultulu = sinyal2 + gurultu2

# 4. Ayrı Ayrı DFT Analizleri
freqs1, mag1 = compute_dft(sinyal1_gurultulu, fs)
freqs2, mag2 = compute_dft(sinyal2_gurultulu, fs)

# 5. Sinyallerin Toplanması ve Toplam DFT Analizi
toplam_sinyal = sinyal1_gurultulu + sinyal2_gurultulu
freqs_toplam, mag_toplam = compute_dft(toplam_sinyal, fs)

# 6. Görselleştirme
plt.figure(figsize=(12, 10))

# Ayrı Ayrı DFT Sonuçları
plt.subplot(3, 1, 1)
plt.plot(freqs1[:100], mag1[:100], color='blue', label='Sinyal 1 DFT (50 Hz)')
plt.plot(freqs2[:100], mag2[:100], color='green', alpha=0.7, label='Sinyal 2 DFT (30 Hz)')
plt.title("Sinyal 1 ve Sinyal 2'nin Ayrı Ayrı DFT Analizi (İlk 100 Hz)")
plt.xlabel("Frekans (Hz)")
plt.ylabel("Genlik")
plt.legend()
plt.grid(True, linestyle='--', alpha=0.6)

# Toplam Sinyal (Zaman Uzayı)
plt.subplot(3, 1, 2)
plt.plot(t[:200], toplam_sinyal[:200], color='purple')
plt.title("Toplam Sinyal (Zaman Uzayı - İlk 200 Örneklem)")
plt.xlabel("Zaman (saniye)")
plt.ylabel("Genlik")
plt.grid(True, linestyle='--', alpha=0.6)

# Toplam Sinyal DFT Analizi
plt.subplot(3, 1, 3)
plt.plot(freqs_toplam[:100], mag_toplam[:100], color='red', linewidth=2)
plt.title("Toplam Sinyalin DFT Analizi (İlk 100 Hz)")
plt.xlabel("Frekans (Hz)")
plt.ylabel("Genlik")
plt.grid(True, linestyle='--', alpha=0.6)

plt.tight_layout()
plt.show()
