import numpy as np
import matplotlib.pyplot as plt

# --- 1. ZNCC Metriği Fonksiyonu ---
def calculate_zncc(img1, img2):
    """İki görüntü arasındaki ZNCC (Zero Mean Normalized Cross Correlation) değerini hesaplar."""
    img1 = img1.astype(np.float64)
    img2 = img2.astype(np.float64)
    
    # Sıfır Ortalama (Zero Mean) adımı
    img1_zm = img1 - np.mean(img1)
    img2_zm = img2 - np.mean(img2)
    
    # Pay: Kovaryans
    numerator = np.sum(img1_zm * img2_zm)
    
    # Payda: Standart Sapmaların Çarpımı
    denominator = np.sqrt(np.sum(img1_zm**2) * np.sum(img2_zm**2))
    
    if denominator == 0:
        return 0.0
    return numerator / denominator

# --- 2. Ters DFT (IDFT) Fonksiyonu ---
def compute_inverse_dft(f_shift):
    """Merkezileştirilmiş frekans matrisini tersine çevirip görüntüyü geri oluşturur."""
    # Merkeze kaydırılmış düşük frekansları eski yerine (köşelere) al
    f_ishift = np.fft.ifftshift(f_shift)
    # Ters 2D FFT uygula
    img_back = np.fft.ifft2(f_ishift)
    # Karmaşık sayıların sadece reel (gerçek) kısmını al
    return np.real(img_back)

