import numpy as np
import matplotlib.pyplot as plt

# 1. Gauss Gürültüsü Ekleme Fonksiyonu
def add_gaussian_noise(image, std_dev=25.0):
    """Resme normal dağılımlı (Gauss) gürültü ekler. Kuvveti standart sapma (std_dev) belirler."""
    # Resimle aynı boyutta Gauss gürültüsü üret
    noise = np.random.normal(0, std_dev, image.shape)
    # Gürültüyü ekle ve [0, 255] aralığında kırp (clip)
    noisy_image = np.clip(image + noise, 0, 255).astype(np.uint8)
    return noisy_image

# 2. Salt and Pepper (Tuz ve Biber) Gürültüsü Ekleme Fonksiyonu
def add_salt_and_pepper_noise(image, noise_ratio=0.05):
    """Resme % olarak verilen oranda (noise_ratio) siyah ve beyaz pikseller ekler."""
    noisy_image = np.copy(image)

    # Eklenecek toplam tuz ve biber piksel sayısını hesapla
    num_salt = np.ceil(noise_ratio * image.size * 0.5)
    num_pepper = np.ceil(noise_ratio * image.size * 0.5)

    # Tuz (Beyaz - 255) pikselleri rastgele yerleştir
    coords_salt = [np.random.randint(0, i, int(num_salt)) for i in image.shape]
    noisy_image[tuple(coords_salt)] = 255

    # Biber (Siyah - 0) pikselleri rastgele yerleştir
    coords_pepper = [np.random.randint(0, i, int(num_pepper)) for i in image.shape]
    noisy_image[tuple(coords_pepper)] = 0

    return noisy_image

